// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(uuid())
  nombre    String    @unique @db.VarChar(50)
  activo    Boolean   @default(true)
  orden     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id               String      @id
  nombre           String      @db.VarChar(100)
  precioMenudeo    Decimal     @db.Decimal(10, 2)
  precioMayoreo    Decimal     @db.Decimal(10, 2)
  precioProduccion Decimal     @db.Decimal(10, 2)
  categoria        String      @db.VarChar(50)
  activo           Boolean     @default(true)
  // true = la corona ya trae imagen: en los pedidos no se cobra aparte
  incluyeImagen    Boolean     @default(false) @map("incluye_imagen")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  saleItems        SaleItem[]
  prices           ProductPrice[]

  @@map("products")
}

// Precio de un producto en un año. Cada año tiene su propia fila: no se sobrescribe el anterior.
model ProductPrice {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  year             Int
  precioMenudeo    Decimal  @db.Decimal(10, 2)
  precioMayoreo    Decimal  @db.Decimal(10, 2)
  precioProduccion Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, year])
  @@map("product_prices")
}

// Extras que se pueden agregar a una corona de un pedido. Qué extras se ofrecen y a qué precio
// cambia por año (ver AddonPrice); aquí solo vive su identidad.
model AddonDef {
  id     String     @id @default(uuid())
  key    String     @unique @db.VarChar(60)
  name   String     @db.VarChar(60)
  group  AddonGroup
  orden  Int        @default(0)

  @@map("addon_defs")
}

// Precio de un extra (pata, ramo, imagen) en un año
model AddonPrice {
  id        String   @id @default(uuid())
  key       String   @db.VarChar(60)
  year      Int
  name      String   @db.VarChar(60)
  price     Decimal  @db.Decimal(10, 2)
  // false = ese año ya no se ofrece
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, year])
  @@map("addon_prices")
}

// Colores que se ofrecen al hacer un pedido
model ColorOption {
  id     String  @id @default(uuid())
  name   String  @unique @db.VarChar(50)
  activo Boolean @default(true)
  orden  Int     @default(0)

  @@map("color_options")
}

model Sale {
  id           String     @id @default(uuid())
  ticketNumber String     @unique @db.VarChar(20)
  type         SaleType
  total        Decimal    @db.Decimal(10, 2)
  totalItems   Int
  customerName String?    @db.VarChar(100)
  customerPhone String?   @db.VarChar(20)
  customerId   String?    @map("customer_id")
  createdAt    DateTime   @default(now())
  items        SaleItem[]
  customer     Customer?  @relation(fields: [customerId], references: [id])

  @@map("sales")
}

model Customer {
  id        String   @id @default(uuid())
  nombre    String   @db.VarChar(100)
  telefono  String   @db.VarChar(20)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@unique([telefono])
  @@map("customers")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String   @map("sale_id")
  productId   String   @map("product_id")
  productName String   @db.VarChar(100)
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  
  sale        Sale     @relation(fields: [saleId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model CashCut {
  id               String   @id @default(uuid())
  totalMenudeo     Decimal  @db.Decimal(10, 2)
  totalMayoreo     Decimal  @db.Decimal(10, 2)
  totalGeneral     Decimal  @db.Decimal(10, 2)
  ventasMenudeo    Int
  ventasMayoreo    Int
  totalVentas      Int
  gananciaEstimada Decimal  @db.Decimal(10, 2)
  fechaCorte       DateTime @default(now())
  fechaInicio      DateTime @db.Date
  fechaFin         DateTime @db.Date

  @@map("cash_cuts")
}

model Layaway {
  id            String          @id @default(uuid())
  folio         String          @unique @db.VarChar(20)
  customerName  String          @db.VarChar(100)
  customerPhone String?         @db.VarChar(20)
  total         Decimal         @db.Decimal(10, 2)
  deposit       Decimal         @db.Decimal(10, 2)
  status        LayawayStatus   @default(activo)
  kind          LayawayKind     @default(apartado)
  // Etapa de elaboración; solo se usa en los pedidos
  production    ProductionStatus @default(por_procesar)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         LayawayItem[]
  payments      LayawayPayment[]

  @@map("layaways")
}

model LayawayItem {
  id          String  @id @default(uuid())
  layawayId   String  @map("layaway_id")
  productId   String  @map("product_id")
  productName String  @db.VarChar(100)
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)

  // Datos del pedido (solo cuando kind = pedido)
  color       String? @db.VarChar(100)
  flores      String? @db.VarChar(200)
  imagenDesc  String? @db.VarChar(200)
  cromoDesc   String? @db.VarChar(200)

  layaway     Layaway @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  addons      LayawayItemAddon[]

  @@map("layaway_items")
}

// Extra agregado a una corona del pedido (pata, ramo, imagen) con su precio al momento
model LayawayItemAddon {
  id     String      @id @default(uuid())
  itemId String      @map("item_id")
  key    String      @db.VarChar(60)
  name   String      @db.VarChar(60)
  // Para los ramos: qué flores lleva ese ramo
  detail String?     @db.VarChar(200)
  // Cuántas piezas son (ej. 2 ramos); price es el total de la línea
  quantity Int       @default(1)
  price  Decimal     @db.Decimal(10, 2)

  item   LayawayItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([key])
  @@map("layaway_item_addons")
}

model LayawayPayment {
  id        String   @id @default(uuid())
  layawayId String   @map("layaway_id")
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  layaway   Layaway  @relation(fields: [layawayId], references: [id], onDelete: Cascade)

  @@map("layaway_payments")
}

enum AddonGroup {
  extra
  imagen
  ramo

  @@map("addon_group_enum")
}

enum ProductionStatus {
  por_procesar
  procesando
  listo

  @@map("production_status_enum")
}

enum LayawayKind {
  apartado
  pedido

  @@map("layaway_kind_enum")
}

enum LayawayStatus {
  activo
  entregado
  cancelado

  @@map("layaway_status_enum")
}

enum SaleType {
  menudeo
  mayoreo

  @@map("sales_type_enum")
}

